<view class="container">
  <view class="summary-card">
    <view class="summary-sticker">Stats</view>
    <view class="summary-label">当前结余</view>
    <view class="balance {{balanceClass}}">¥{{balance}}</view>
    <view class="summary-row">
      <view class="summary-item">
        <text class="item-label">总收入</text>
        <text class="summary-value income">¥{{totalIncome}}</text>
      </view>
      <view class="summary-item">
        <text class="item-label">总支出</text>
        <text class="summary-value expense">¥{{totalExpense}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">{{monthTitle}}</view>
    <view class="month-grid">
      <view class="month-cell">
        <text class="cell-label">本月收入</text>
        <text class="cell-value income">¥{{monthIncome}}</text>
      </view>
      <view class="month-cell">
        <text class="cell-label">本月支出</text>
        <text class="cell-value expense">¥{{monthExpense}}</text>
      </view>
      <view class="month-cell">
        <text class="cell-label">今日支出</text>
        <text class="cell-value">¥{{todayExpense}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">支出分类排行</view>
    <view class="empty" wx:if="{{categoryStats.length === 0}}">暂无支出记录</view>
    <view class="rank-list" wx:else>
      <view class="rank-item" wx:for="{{categoryStats}}" wx:key="name">
        <view class="rank-top">
          <text class="rank-name">{{item.name}}</text>
          <text class="rank-money">¥{{item.amount}}</text>
        </view>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{item.percent}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">最近流水</view>
    <view class="empty" wx:if="{{latestBills.length === 0}}">还没有账单，先去记一笔吧</view>
    <view class="bill-list" wx:else>
      <view class="bill-row" wx:for="{{latestBills}}" wx:key="id">
        <view class="bill-left">
          <text class="bill-category">{{item.category}}</text>
          <text class="bill-date">{{item.date}}</text>
        </view>
        <view class="bill-right">
          <text class="{{item.type === '支出' ? 'expense' : 'income'}}">
            {{item.type === '支出' ? '-' : '+'}}¥{{item.money}}
          </text>
        </view>
      </view>
    </view>
  </view>
</view>
